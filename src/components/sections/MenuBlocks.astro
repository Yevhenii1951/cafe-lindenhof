---
import { Croissant, CookingPot, Cake } from '@lucide/astro';
import { menuListBlocks } from '../../lib/menu';
import { photo } from '../../lib/images';

const icons = { croissant: Croissant, cooking: CookingPot, cake: Cake } as const;
---

<section class="section">
  <div class="container-site flex flex-col gap-14">
    {
      menuListBlocks.map((block, index) => (
        <article
          id={block.id}
          class:list={['mb-block', `mb-block--${block.side}`, index > 0 && 'lg:mt-14']}
        >
          <div class="mb-media">
            <img
              src={photo(block.imageIndex, 1200)}
              alt={block.title}
              width={670}
              height={485}
              loading="lazy"
              class="h-[320px] w-full object-cover lg:h-[485px]"
            />
          </div>

          <div class="menu-list-card card-shadow">
            <div class="mb-5 flex items-center gap-3">
              {(() => {
                const Icon = icons[block.icon];
                return <Icon size={28} style="color:var(--accent)" />;
              })()}
              <h2 class="m-0 text-lg font-bold uppercase tracking-[3px] text-ink">{block.title}</h2>
            </div>

            <div class="scroll">
              {block.groups.map((group) => (
                <div class="menu-group">
                  <p class="cat font-semibold uppercase tracking-wide">{group.category}</p>
                  <ul class="m-0 list-none p-0">
                    {group.items.map((item) => (
                      <li class="mb-4">
                        <div class="menu-item">
                          <span class="title">{item.name}</span>
                          <span class="lead-dots" aria-hidden="true" />
                          <span class="amount">{item.price}</span>
                        </div>
                        <p class="m-0 text-[14px] leading-relaxed">{item.note}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
